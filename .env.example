# Environment configuration. Pass with --dart-define-from-file=.env (never commit real values).
# MOSAIC_MODE: mock | live
MOSAIC_MODE=mock
MOSAIC_API_BASE_URL=https://api.example.invalid/mosaic
MOSAIC_WS_URL=wss://api.example.invalid/mosaic/ws
# Public-key pins (base64 SHA-256 of SPKI). Keep a backup pin for rotation.
MOSAIC_PIN_PRIMARY=
MOSAIC_PIN_BACKUP=
